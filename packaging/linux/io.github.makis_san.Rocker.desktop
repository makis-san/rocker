[Desktop Entry]
Type=Application
Name=Rocker
GenericName=Docker Desktop Client
Comment=A native desktop client for the Docker Engine API
Exec=rocker %F
Icon=io.github.makis_san.Rocker
Terminal=false
Categories=Development;
Keywords=docker;container;desktop;engine;
StartupWMClass=rocker
MimeType=x-scheme-handler/docker;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=rocker
