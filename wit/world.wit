// Rocker component-extension world (PLAN §5.5, Phase 5b).
//
// Sketch, not frozen. Imports are capability-gated: the host only satisfies the
// interfaces an extension was granted at install time. Extensions never run
// render code against the immediate-mode UI; `render-panel` returns a
// declarative node tree the host draws.

package rocker:extension@0.1.0;

interface types {
    enum lifecycle-action {
        start,
        stop,
        restart,
        pause,
        unpause,
        kill,
    }

    record container {
        id: string,
        name: string,
        image: string,
        state: string,
        status: string,
    }

    enum toast-level {
        info,
        warn,
        error,
    }

    // Declarative UI: a JSON-encoded node tree (see rocker-ext-api::UiNode).
    // Kept as a string in the sketch to avoid churning the WIT while the
    // vocabulary is still driven by real extension needs.
    type ui-node = string;
    type ui-context = string;

    record cluster-context {
        name: string,
        cluster: string,
        user: string,
        current: bool,
    }

    record namespace {
        name: string,
        phase: string,
    }

    enum workload-kind {
        pod,
        deployment,
        stateful-set,
        daemon-set,
        job,
        cron-job,
    }

    record workload-summary {
        kind: workload-kind,
        name: string,
        namespace: string,
        status: string,
        created-at: option<string>,
    }
}

interface containers {
    use types.{container, lifecycle-action};

    list-containers: func() -> list<container>;
    lifecycle: func(id: string, action: lifecycle-action) -> result<_, string>;
    logs-tail: func(id: string, lines: u32) -> list<string>;
}

interface storage {
    get: func(key: string) -> option<string>;
    set: func(key: string, value: string);
    delete: func(key: string);
}

interface notify {
    use types.{toast-level};

    toast: func(level: toast-level, text: string);
}

interface events {
    subscribe: func(kinds: list<string>);
}

// Kubernetes is intentionally a separate import rather than an extension of
// `containers`: Kubernetes has distinct identity, RBAC, watch, and lifecycle
// semantics. The host owns kubeconfig and network access; the component sees
// only these normalized records.
interface kubernetes {
    use types.{cluster-context, namespace, workload-summary};

    list-contexts: func() -> result<list<cluster-context>, string>;
    list-namespaces: func(context: string) -> result<list<namespace>, string>;
    list-workloads: func(context: string, namespace: string) -> result<list<workload-summary>, string>;
}

world rocker-extension {
    import containers;
    import storage;
    import notify;
    import events;
    import kubernetes;

    export activate: func();
    export render-panel: func(ctx: string) -> string;
}
